{
  "expo": {
    "name": "Nuzha's Portfolio",
    "slug": "NuzhaPortfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "nuzhaportfolio",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "rw.ac.ines.ug2527419.nuzhaportfolio",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 1
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "rw.ac.ines.ug2527419.nuzhaportfolio"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image-picker",
      "expo-camera"
    ],
    "extra": {
      "eas": {
        "projectId": "8834f0bc-6d3d-4f85-a968-dda5df3375c4"
      }
    },
    "owner": "5doll",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}